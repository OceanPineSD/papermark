# App
NEXT_PUBLIC_BASE_URL=https://docs.tung.digital
NEXT_PUBLIC_MARKETING_URL=https://docs.tung.digital
NEXT_PUBLIC_APP_BASE_HOST=docs.tung.digital
NEXTAUTH_URL=https://docs.tung.digital
ALLOWED_SIGNIN_EMAILS=oceanpine99@gmail.com
EMAIL_FROM=Tung Nguyen <docs@tung.digital>

# Generated secrets (run scripts/gen-secrets.sh)
NEXTAUTH_SECRET=
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=
NEXT_PRIVATE_VERIFICATION_SECRET=
INTERNAL_API_KEY=
NEXT_PRIVATE_UNSUBSCRIBE_JWT_SECRET=

# Database (Replit Postgres: copy DATABASE_URL into both)
POSTGRES_PRISMA_URL=
POSTGRES_PRISMA_URL_NON_POOLING=

# Storage (Cloudflare R2)
NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
NEXT_PRIVATE_UPLOAD_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
NEXT_PRIVATE_UPLOAD_REGION=auto
NEXT_PRIVATE_UPLOAD_BUCKET=tung-docs
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST=<ACCOUNT_ID>.r2.cloudflarestorage.com
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=

# Analytics (Tinybird)
TINYBIRD_TOKEN=
TINYBIRD_BASE_URL=

# Upstash Redis (same database for both pairs is fine)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_LOCKER_URL=
UPSTASH_REDIS_REST_LOCKER_TOKEN=

# Upstash QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Trigger.dev (project "tung-docs", prod environment)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Email (Resend, with tung.digital verified)
RESEND_API_KEY=
